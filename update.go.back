package main

import (
	"crypto/rand"
	"crypto/rsa"
	"crypto/x509"
	"encoding/pem"
	"flag"
	"fmt"
	"github.com/ahmr-bot/ME-Frp/pkg"
	"github.com/ahmr-bot/ME-Frp/pkg/config"
	"github.com/ahmr-bot/ME-Frp/pkg/mysql"
	"gorm.io/gorm"
)

var (
	ConfigPath string
)

var (
	db *gorm.DB
)

type Realname struct {
	Username string `json:"username"`
	Name     string `json:"name"`
	IDCard   string `json:"idcard"`
	Time     int64  `json:"time"`
}
type User struct {
	Username string `json:"username"`
	Group    string `json:"group"`
}

func init() {
	flag.StringVar(&ConfigPath, "c", "config.toml", "配置文件路径")
	flag.Parse()
	err := config.LoadConfig(ConfigPath)
	if err != nil {
		panic(err)
	}
	// 设置gin模式
	pkg.SetMode()
}

// RsaEncrypt rsa加密
func RsaEncrypt(origData []byte) ([]byte, error) {
	// 定义 pkcs1 的公钥
	public := `-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAifc1pb3CJSogQ690K5YZ
4gC80lP+aU1rWIviUH+UR+21RP7zb+3+FkcclhafS4BhhBOmMzWQUHAab85k0LXm
WxOtN+2oVjqkNNb2eEMEhARmgnbOGAOlfZJoJLEvnCGMP9YjVMjfuzUeaxxHBiLi
Z3PSabboCPlwUvCOOHP0CKcJZ3W/KHgHvfY+2XJnezekLGgUwP9O4BIQMk90nolg
AyI5bHdLPpcLFj51x4Lwi/SoZLacmSDMTlNikPfiTw3/OjdgJnKxAS1Ni3UwN1Dz
X6l65Pf99CBnxaJzr84/tJZ62IWJK7AtDlIYr5t4jaUDPpf+ilyKhlB0eli0hiei
0QIDAQAB
-----END PUBLIC KEY-----`
	block, _ := pem.Decode([]byte(public))
	if block == nil {
		panic("public key error")
	}
	// 解析公钥
	pubInterface, err := x509.ParsePKIXPublicKey(block.Bytes)
	if err != nil {
		panic(err)
	}
	// 类型断言
	pub := pubInterface.(*rsa.PublicKey)
	// 加密
	return rsa.EncryptPKCS1v15(rand.Reader, pub, origData)
}

func main() {
	// 连接MySQL数据库
	db = mysql.ConnectMySQL()

	// 读取 realnames 表中的数据
	var realnames []Realname
	db.Find(&realnames)
	// 读取 users 表中的数据
	var users []User
	db.Find(&users)
	// 创建一个 映射 值为 group username 为 key 的 map
	userMap := make(map[string]string)
	for _, user := range users {
		userMap[user.Username] = user.Group
	}
	// 遍历 realnames 表中的数据
	i := 0
	for _, realname := range realnames {
		// 更新映射中的 group 为 realname
		userMap[realname.Username] = "realname"
		fmt.Printf("更新用户 %s 的 group 为 realname\n", realname.Username)
		// i 自增
		i++
	}
	// 将更新后的数据写入到 users 表中
	// 输出更新成功的消息
	fmt.Printf("更新成功 %d 条数据\n", i)
}
